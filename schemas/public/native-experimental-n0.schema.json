{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope",
  "type": "object",
  "properties": {
    "body": {
      "$ref": "#/definitions/Message"
    },
    "namespace": {
      "$ref": "#/definitions/Namespace"
    },
    "version": {
      "$ref": "#/definitions/Version"
    }
  },
  "additionalProperties": false,
  "required": [
    "namespace",
    "version",
    "body"
  ],
  "definitions": {
    "ApprovalBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not_required"
            },
            "policy_revision": {
              "$ref": "#/definitions/Revision"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "policy_revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approval": {
              "$ref": "#/definitions/RecordRef"
            },
            "kind": {
              "type": "string",
              "const": "required"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "approval"
          ]
        }
      ]
    },
    "BufferKind": {
      "type": "string",
      "enum": [
        "primary",
        "alternate"
      ]
    },
    "BufferRef": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/definitions/Revision"
        },
        "kind": {
          "$ref": "#/definitions/BufferKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "generation"
      ]
    },
    "Cell": {
      "type": "object",
      "properties": {
        "occupancy": {
          "$ref": "#/definitions/Occupancy"
        },
        "style": {
          "$ref": "#/definitions/Style"
        },
        "text": {
          "type": "string",
          "maxLength": 16
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "occupancy",
        "style"
      ]
    },
    "ClaimKind": {
      "type": "string",
      "enum": [
        "interpretation",
        "activity"
      ]
    },
    "CloseReason": {
      "type": "string",
      "enum": [
        "canceled",
        "disconnected",
        "denied",
        "retired"
      ]
    },
    "Color": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "default"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "indexed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blue": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "green": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rgb"
            },
            "red": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "red",
            "green",
            "blue"
          ]
        }
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "complete_for_selection",
        "partial"
      ]
    },
    "Counter": {
      "description": "Canonical decimal shape only; semantic validation must also enforce <= u64::MAX.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "capture_policy": {
          "$ref": "#/definitions/RecordRef"
        },
        "completeness": {
          "$ref": "#/definitions/Completeness"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RowGap"
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "completeness",
        "capture_policy",
        "gaps"
      ]
    },
    "Credit": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "maximum": 1048576,
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "maximum": 8,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pages",
        "bytes"
      ]
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "blink": {
          "type": "boolean"
        },
        "column": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "shape": {
          "$ref": "#/definitions/CursorShape"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "visible",
        "blink",
        "shape"
      ]
    },
    "CursorShape": {
      "type": "string",
      "enum": [
        "block",
        "underline",
        "bar"
      ]
    },
    "Deadline": {
      "type": "object",
      "properties": {
        "clock_origin_id": {
          "$ref": "#/definitions/Id"
        },
        "ticks": {
          "$ref": "#/definitions/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_origin_id",
        "ticks"
      ]
    },
    "EvidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_event"
            },
            "sequence": {
              "$ref": "#/definitions/Counter"
            },
            "session": {
              "$ref": "#/definitions/SessionRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "session",
            "sequence"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "control_record"
            },
            "record": {
              "$ref": "#/definitions/RecordRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "record"
          ]
        }
      ]
    },
    "Fact": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/definitions/FactEvidence"
        },
        "subject": {
          "$ref": "#/definitions/SessionRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "subject",
        "evidence"
      ]
    },
    "FactEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "claim": {
              "$ref": "#/definitions/SessionClaim"
            },
            "level": {
              "type": "string",
              "const": "observed"
            },
            "producer": {
              "$ref": "#/definitions/Producer"
            },
            "schema": {
              "$ref": "#/definitions/Id"
            },
            "source": {
              "$ref": "#/definitions/EvidenceRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "level",
            "claim",
            "producer",
            "schema",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "channel_id": {
              "$ref": "#/definitions/Id"
            },
            "claim": {
              "$ref": "#/definitions/SessionClaim"
            },
            "level": {
              "type": "string",
              "const": "reported"
            },
            "producer": {
              "$ref": "#/definitions/Producer"
            },
            "schema": {
              "$ref": "#/definitions/Id"
            },
            "source": {
              "$ref": "#/definitions/EvidenceRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "level",
            "claim",
            "producer",
            "channel_id",
            "schema",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "claim": {
              "$ref": "#/definitions/SessionClaim"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EvidenceRef"
              },
              "maxItems": 8,
              "minItems": 1
            },
            "level": {
              "type": "string",
              "const": "inferred"
            },
            "method": {
              "$ref": "#/definitions/Id"
            },
            "producer": {
              "$ref": "#/definitions/Producer"
            }
          },
          "additionalProperties": false,
          "required": [
            "level",
            "claim",
            "producer",
            "method",
            "evidence"
          ]
        },
        {
          "type": "object",
          "properties": {
            "claim": {
              "$ref": "#/definitions/ClaimKind"
            },
            "last_known": {
              "$ref": "#/definitions/Id"
            },
            "level": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/definitions/UnavailableReason"
            }
          },
          "additionalProperties": false,
          "required": [
            "level",
            "claim",
            "reason"
          ]
        }
      ]
    },
    "FrameDelta": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/definitions/FrameStamp"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fact"
          },
          "maxItems": 16
        },
        "presentation": {
          "$ref": "#/definitions/Presentation"
        },
        "replace_rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RowReplacement"
          },
          "maxItems": 32
        },
        "resume_cursor": {
          "$ref": "#/definitions/Id"
        },
        "subscription_id": {
          "$ref": "#/definitions/Id"
        },
        "target": {
          "$ref": "#/definitions/FrameStamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "base",
        "target",
        "replace_rows",
        "presentation",
        "facts",
        "resume_cursor"
      ]
    },
    "FrameStamp": {
      "type": "object",
      "properties": {
        "buffer": {
          "$ref": "#/definitions/BufferRef"
        },
        "capability_revision": {
          "$ref": "#/definitions/Revision"
        },
        "geometry": {
          "$ref": "#/definitions/Geometry"
        },
        "mode_revision": {
          "$ref": "#/definitions/Revision"
        },
        "observation_id": {
          "$ref": "#/definitions/Id"
        },
        "policy": {
          "$ref": "#/definitions/PolicyTuple"
        },
        "processed_frontier": {
          "$ref": "#/definitions/Counter"
        },
        "semantic_revision": {
          "$ref": "#/definitions/Revision"
        },
        "session": {
          "$ref": "#/definitions/SessionRef"
        },
        "source_frontier": {
          "$ref": "#/definitions/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "observation_id",
        "semantic_revision",
        "processed_frontier",
        "source_frontier",
        "geometry",
        "buffer",
        "policy",
        "mode_revision",
        "capability_revision"
      ]
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "maximum": 500,
          "minimum": 2
        },
        "revision": {
          "$ref": "#/definitions/Revision"
        },
        "rows": {
          "type": "integer",
          "maximum": 200,
          "minimum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "rows",
        "columns"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "InputContext": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/definitions/ApprovalBinding"
        },
        "context": {
          "$ref": "#/definitions/RecordRef"
        },
        "deadline": {
          "$ref": "#/definitions/Deadline"
        },
        "endpoint_capability_revision": {
          "$ref": "#/definitions/Revision"
        },
        "endpoint_generation": {
          "$ref": "#/definitions/Revision"
        },
        "endpoint_id": {
          "$ref": "#/definitions/Id"
        },
        "expected": {
          "$ref": "#/definitions/FrameStamp"
        },
        "grant": {
          "$ref": "#/definitions/RecordRef"
        },
        "helper_epoch": {
          "$ref": "#/definitions/Revision"
        },
        "protection_revision": {
          "$ref": "#/definitions/Revision"
        },
        "receipt_profile": {
          "$ref": "#/definitions/RecordRef"
        },
        "route": {
          "$ref": "#/definitions/InputRoute"
        },
        "writer_generation": {
          "$ref": "#/definitions/Revision"
        }
      },
      "additionalProperties": false,
      "required": [
        "receipt_profile",
        "endpoint_id",
        "endpoint_generation",
        "endpoint_capability_revision",
        "helper_epoch",
        "writer_generation",
        "expected",
        "route",
        "protection_revision",
        "grant",
        "context",
        "approval",
        "deadline"
      ]
    },
    "InputIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/definitions/KeyAction"
            },
            "facts": {
              "$ref": "#/definitions/KeyFacts"
            },
            "kind": {
              "type": "string",
              "const": "send_key"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "facts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "commit_text"
            },
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fallback": {
              "$ref": "#/definitions/PasteFallback"
            },
            "kind": {
              "type": "string",
              "const": "paste"
            },
            "newlines": {
              "$ref": "#/definitions/NewlinePolicy"
            },
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "newlines",
            "fallback"
          ]
        },
        {
          "type": "object",
          "properties": {
            "gained": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "focus_report"
            },
            "view": {
              "$ref": "#/definitions/ViewBinding"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view",
            "gained"
          ]
        }
      ]
    },
    "InputRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/definitions/InputContext"
        },
        "intent": {
          "$ref": "#/definitions/InputIntent"
        },
        "key": {
          "$ref": "#/definitions/MutationKey"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "context",
        "intent"
      ]
    },
    "InputRoute": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct_session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/definitions/ViewBinding"
            },
            "kind": {
              "type": "string",
              "const": "view"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding"
          ]
        }
      ]
    },
    "KeyAction": {
      "type": "string",
      "enum": [
        "press",
        "repeat",
        "release"
      ]
    },
    "KeyFacts": {
      "type": "object",
      "properties": {
        "composing": {
          "type": "boolean"
        },
        "consumed_modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Modifier"
          },
          "maxItems": 5
        },
        "layout_id": {
          "$ref": "#/definitions/Id"
        },
        "logical": {
          "$ref": "#/definitions/LogicalKey"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Modifier"
          },
          "maxItems": 5
        },
        "phase": {
          "$ref": "#/definitions/KeyAction"
        },
        "physical_code": {
          "$ref": "#/definitions/Id"
        }
      },
      "additionalProperties": false
    },
    "LogicalKey": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/definitions/NamedKey"
            },
            "kind": {
              "type": "string",
              "const": "named"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "character"
            },
            "text": {
              "type": "string",
              "maxLength": 1,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "Message": {
      "description": "Read correlation is not a mutation identity. Input requests use the issued key above.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "limits": {
              "$ref": "#/definitions/ReceiptLimits"
            },
            "message": {
              "type": "string",
              "const": "receipt_profile_proposal"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "limits"
          ]
        },
        {
          "type": "object",
          "properties": {
            "correlation_id": {
              "$ref": "#/definitions/Id"
            },
            "credit": {
              "$ref": "#/definitions/Credit"
            },
            "message": {
              "type": "string",
              "const": "subscribe"
            },
            "session": {
              "$ref": "#/definitions/SessionRef"
            },
            "start": {
              "$ref": "#/definitions/SubscriptionStart"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "correlation_id",
            "session",
            "start",
            "credit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "$ref": "#/definitions/Id"
            },
            "message": {
              "type": "string",
              "const": "read_page"
            },
            "subscription_id": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "subscription_id",
            "cursor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "credit": {
              "$ref": "#/definitions/Credit"
            },
            "message": {
              "type": "string",
              "const": "grant_credit"
            },
            "subscription_id": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "subscription_id",
            "credit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "cancel_subscription"
            },
            "subscription_id": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "subscription_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "snapshot_page"
            },
            "page": {
              "$ref": "#/definitions/SnapshotPage"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "page"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "observation_unavailable"
            },
            "projection": {
              "$ref": "#/definitions/Projection"
            },
            "reason": {
              "$ref": "#/definitions/UnavailableReason"
            },
            "session": {
              "$ref": "#/definitions/SessionRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "session",
            "projection",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "$ref": "#/definitions/FrameDelta"
            },
            "message": {
              "type": "string",
              "const": "frame_delta"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "resync_required"
            },
            "reason": {
              "$ref": "#/definitions/ResyncReason"
            },
            "subscription_id": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "subscription_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "subscription_closed"
            },
            "reason": {
              "$ref": "#/definitions/CloseReason"
            },
            "subscription_id": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "message",
            "subscription_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "const": "input"
            },
            "request": {
              "$ref": "#/definitions/InputRequest"
            }
          },
          "additionalProperties": false,
          "required": [
