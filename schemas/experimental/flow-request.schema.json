{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "version": {
      "$ref": "#/$defs/Version"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "operation"
  ],
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "context": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "producer_attempt": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "epoch",
        "context",
        "producer_attempt",
        "revision",
        "sha256",
        "bytes"
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "string"
        },
        "connection": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "context": {
          "type": "string"
        },
        "control": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "task": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "epoch",
        "context",
        "run",
        "task",
        "attempt",
        "connection",
        "control",
        "profile"
      ]
    },
    "Operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "observe"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "after"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/Binding"
            },
            "dependency": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "op": {
              "type": "string",
              "const": "queue"
            },
            "sequence": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sequence",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "dispatch"
            },
            "sequence": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sequence"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_control": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "takeover"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "expected_control"
          ]
        }
      ]
    },
    "Run": {
      "type": "string",
      "enum": [
        "producer",
        "consumer"
      ]
    },
    "Version": {
      "type": "string",
      "enum": [
        "namtab.flow/0"
      ]
    }
  }
}
