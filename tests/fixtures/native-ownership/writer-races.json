        },
        {
          "order": "7",
          "event": "TUI explicitly takes input; final boundary acknowledges generation 3; delayed desktop keys arrive.",
          "expected": {
            "writer_endpoint": "endpoint-tui",
            "writer_generation": "3",
            "delayed_desktop_delivery": "zero",
            "old_queues_replayed": false
