# Finite MK1 core only. No xterm identity or unimplemented insert/delete caps.
namtab-mk1|namtab owned finite MK1 terminal,
    am,
    cols#80, lines#24,
    bel=^G, cr=^M, cud1=^J, ht=^I,
    clear=\E[H\E[2J, home=\E[H,
    cup=\E[%i%p1%d;%p2%dH,
    cub1=\E[D, cuf1=\E[C, cuu1=\E[A,
    el=\E[K, ed=\E[J,
    sc=\E7, rc=\E8,
    civis=\E[?25l, cnorm=\E[?25h,
    smcup=\E[?1049h, rmcup=\E[?1049l,
    smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
    sgr0=\E[0m,
    kbs=\177, kent=^M,
    kcuu1=\EOA, kcud1=\EOB, kcub1=\EOD, kcuf1=\EOC,
    khome=\EOH, kend=\EOF,
    kich1=\E[2~, kdch1=\E[3~, kpp=\E[5~, knp=\E[6~,
